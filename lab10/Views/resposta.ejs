<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <title>Title</title>
        <link href="estilo.css" rel="stylesheet">
    </head>
    <body>
        <h1>Resposta para o usuário</h1>

        <% if(nome){ %>
            <p>Usuário criado: <%= nome %></p>
        <% } %>

        <% if(login){ %>
            <p>Login: <%= login %></p>
        <% } %>

        <% if(status){ %>
            <p><%= status %></p>
        <% } %>

    </body>
</html>
